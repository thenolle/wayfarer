{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@gambrel/view",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "test"]
}
