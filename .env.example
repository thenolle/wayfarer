# .env.example
# Copy to .env and edit. Docker Compose reads this file automatically.

# Required. Use at least 16 characters, for example: openssl rand -hex 32
WAYFARER_AUTH_TOKEN=change-me-to-a-long-random-string

# Host names (without ports) that may be used to reach the service.
# Add your public name when running behind a reverse proxy.
WAYFARER_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional tuning. Defaults are shown.
WAYFARER_MAX_SEGMENTS=8
WAYFARER_MAX_CONCURRENT_DOWNLOADS=3
WAYFARER_BANDWIDTH_LIMIT=0
